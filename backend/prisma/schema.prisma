// food+ — esquema de base de datos (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Los 14 alérgenos de declaración obligatoria (Reglamento UE 1169/2011).
// Coinciden con las etiquetas `allergens_tags` de Open Food Facts (en:gluten, en:milk, ...).
enum Allergen {
  GLUTEN
  CRUSTACEANS
  EGGS
  FISH
  PEANUTS
  SOYBEANS
  MILK
  NUTS
  CELERY
  MUSTARD
  SESAME_SEEDS
  SULPHITES
  LUPIN
  MOLLUSCS
}

enum Plan {
  FREE
  PREMIUM
}

enum ScanType {
  BARCODE
  SEARCH
  OCR
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique @db.VarChar(255)
  passwordHash String  @db.VarChar(255)
  name         String? @db.VarChar(100)

  // --- Freemium ---
  plan            Plan      @default(FREE)
  scanCount       Int       @default(0) // escaneos usados en la tanda actual
  scanWindowStart DateTime? // inicio de la tanda; se recarga SCAN_WINDOW_HOURS después

  // --- Stripe ---
  stripeCustomerId     String?   @unique @db.VarChar(255)
  stripeSubscriptionId String?   @unique @db.VarChar(255)
  subscriptionStatus   String?   @db.VarChar(50) // active | past_due | canceled | ...
  currentPeriodEnd     DateTime?

  allergies     UserAllergy[]
  scans         ScanHistory[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserAllergy {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  allergen Allergen

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, allergen])
  @@map("user_allergies")
}

model ScanHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  type        ScanType
  barcode     String?  @db.VarChar(32)
  query       String?  @db.VarChar(200)
  productName String?  @db.VarChar(255)

  // Resultado del análisis contra las alergias del usuario en el momento del escaneo
  isSafe           Boolean?
  matchedAllergens Allergen[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("scan_history")
}

// Refresh tokens rotativos (se guarda solo el hash SHA-256, nunca el token en claro)
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}
